#include<bits/stdc++.h>
using namespace std;
int w,s,ans;
vector<int> all;
int main(){
    cin>>w>>s;
    all.resize(s);
    for(int i=0;i<s;i++){
        cin>>all[i];
    }
    sort(all.begin(),all.end(),[](const int& a,const int& b){return a<b;});
    int top,di;
    top=0;
    di=s-1;
    while(top<=di){
        if(all[top]+all[di]<=w){
            ans+=1;
            top+=1;
            di-=1;
        }else{
            ans+=1;
            di-=1;
        }
    }
    cout<<ans<<endl;
    return 0;
}